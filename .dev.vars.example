# Local-only Worker variables read by the dev server. Copy to .dev.vars.
# A disposable moderator handle lets the smoke test cover the queue:
#   ASSBOOK_ADMIN_HANDLE=test_mod_local npm run test:smoke
ADMIN_HANDLE=test_mod_local
# Photo check: on (Workers AI), off, or test (verdict from the
# X-Photo-Check-Test header, used by the smoke test).
PHOTO_CHECK=test
