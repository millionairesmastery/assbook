{
  "name": "assbook",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "assbook",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "assbook-photos"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "ADMIN_HANDLE": "",
    "APP_ORIGIN": "https://your-assbook.example",
    "EMAIL_FROM": "accounts@your-assbook.example"
  }
}
